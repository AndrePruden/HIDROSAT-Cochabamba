  "epistemological_ablations": {
    "ablation_1_dem_choice_dsm_vs_fabdem": {
      "naive_approach": "Using standard Copernicus GLO-30 DSM or SRTM (contains building roofs & riparian Eucalyptus/Molle trees)",
      "rigorous_approach": "Using FABDEM V1-2 bare-earth DTM (30m building/canopy removed)",
      "riparian_corridor_mean_positive_bias_m": 2.452,
      "riparian_corridor_p90_positive_bias_m": 8.242,
      "false_channel_dams_created_by_dsm_pixels": 9328,
      "false_urban_sinks_created_by_dsm_ha": 476.77,
      "true_bare_earth_sinks_in_fabdem_ha": 632.22,
      "conclusion": "Standard DSMs inject +8.24 m (90th percentile) artificial walls along Cochabamba's torrenteras, creating 9,328 false dam pixels and 476.8 ha of artificial street-canyon sinks while obscuring true bare-earth paleochannel avulsion paths."
    },
    "ablation_2_sar_urban_exclusion_and_layover": {
      "naive_approach": "Applying SAR (Sentinel-1 C-band or NISAR/ALOS L-band) directly over urban Cochabamba to map street flooding or soil moisture",
      "rigorous_approach": "Masking out Limite Urbano / WorldCover Built-Up (where dihedral corner reflections dominate) and restricting SAR retrieval to non-urban Upper Tunari watersheds (>2750m) with Dual-Orbit (Asc+Desc) fusion",
      "urban_cband_vv_dry_db": -4.73,
      "urban_cband_vv_wet_db": -4.91,
      "urban_seasonal_delta_db": -0.19,
      "urban_double_bounce_contamination_pct": 52.1,
      "tunari_cband_mean_wetting_delta_db": 1.06,
      "tunari_cband_p90_wetting_delta_db": 6.57,
      "single_orbit_descending_layover_loss_pct": 11.0,
      "single_orbit_ascending_layover_loss_pct": 8.2,
      "dual_orbit_fused_unrecoverable_pct": 1.5,
      "conclusion": "In urban Cochabamba, brick/concrete dihedral corner reflectors lock C-band VV at -4.73 dB (dry) vs -4.91 dB (wet), yielding zero moisture sensitivity (-0.19 dB noise, 52.1% double-bounce contaminated). Conversely, in non-urban Tunari catchments above Cota 2750, dual-orbit SAR recovers 98.5% of steep terrain and detects +1.06 dB mean (up to +1.94 dB basin-wide and +6.57 dB P90 in colluvial hollows) dielectric wetting."
    },
    "ablation_3_precipitation_spatial_temporal_scale": {
      "naive_approach": "Claiming real-time street-level flash flood nowcasting from satellite precipitation (GPM IMERG ~10km or ERA5-Land ~9km)",
      "rigorous_approach": "Using mesoscale precipitation & root-zone soil moisture strictly for multi-day Antecedent Pre-Conditioning (API_14, dynamic CN storage S(t), debris bulking BF(t), and critical trigger threshold P_crit)",
      "nominal_satellite_rain_pixel_area_km2": 100.0,
      "tunari_watershed_count": 23,
      "tunari_watershed_median_area_km2": 6.22,
      "tunari_watershed_min_area_km2": 1.49,
      "tunari_watershed_max_area_km2": 184.24,
      "watersheds_smaller_than_single_imerg_pixel": "22/23",
      "tunari_kirpich_tc_median_minutes": 22.2,
      "tunari_kirpich_tc_range_minutes": [
        8.6,
        158.8
      ],
      "watersheds_with_sub_60min_concentration_time": "22/23",
      "conclusion": "All 22/23 Tunari watersheds (median area 6.2 km2) are smaller than a single ~100 km2 satellite precipitation pixel, and 22/23 have flash-flood concentration times under 60 minutes (median 22.2 min) — faster than satellite latency. Therefore, multi-day antecedent pre-conditioning is the only physically rigorous predictive formulation."
    },
    "ablation_4_anti_tautology_off_channel_discovery": {
      "naive_approach": "Flagging a fixed buffer around mapped torrenteras and rivers ('there is flood risk near rivers')",
      "rigorous_approach": "Excluding the trivial <=120m river corridor from novel hazard discovery and identifying off-channel alluvial-fan paleochannel avulsion corridors (PALEO-*), apex hydraulic choke points (AVN-*), and valley-floor endorheic/backwater depressions (SINK-*)",
