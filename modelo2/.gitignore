data/raw/*.zip
data/processed/rasters/*.tif
data/processed/gamc/poblacion_manzanas.geojson
data/processed/gamc/areas_verdes.geojson
data/processed/gamc/areas_equipamiento.geojson

# OS / temporary files
.DS_Store
*.log
